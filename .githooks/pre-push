#!/bin/sh
# Lưới an toàn trước khi đẩy lên: bảo đảm docs/ khớp mã nguồn của main.
# Build lỗi thì chặn push. Nếu bản build đổi, hook tự commit docs/ rồi dừng push
# để commit đó nằm trong lần push kế tiếp: chạy lại git push.
# Bỏ qua bằng: SKIP_PAGES_BUILD=1 git push
dir="$(dirname "$0")"
"$dir/build-docs.sh"
code=$?
if [ "$code" -eq 10 ]; then
  echo "[pre-push] Chạy lại 'git push' để đẩy kèm commit build docs."
  exit 1
fi
exit "$code"
