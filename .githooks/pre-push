#!/bin/sh
# Build app và đẩy bản build lên nhánh gh-pages (GitHub Pages chỉ phục vụ file tĩnh).
# Build lỗi thì push bị chặn. Bỏ qua bằng: SKIP_PAGES_BUILD=1 git push
set -e

[ -n "$SKIP_PAGES_BUILD" ] && exit 0

remote_name="$1"
remote_url="$2"
root="$(git rev-parse --show-toplevel)"

# Không build lại khi chính hook này đang push gh-pages
while read -r _ _ remote_ref _; do
  [ "$remote_ref" = "refs/heads/gh-pages" ] && exit 0
done

echo "[pre-push] Build app (base=/chia-tien/)..."
(cd "$root/app" && npm run build -- --base=/chia-tien/)

echo "[pre-push] Đẩy app/dist lên nhánh gh-pages của $remote_name..."
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cp -R "$root/app/dist/." "$tmp/"
touch "$tmp/.nojekyll"
(
  cd "$tmp"
  git init -q
  git checkout -q -b gh-pages
  git add -A
  git -c user.name="$(git -C "$root" config user.name)" \
      -c user.email="$(git -C "$root" config user.email)" \
      commit -q -m "Build $(git -C "$root" rev-parse --short HEAD)"
  git push -q --force "$remote_url" gh-pages:gh-pages
)
